-- Script PostgreSQL completo gerado a partir do modelo MySQL (versão final ajustada)
-- Banco alvo: salf_db

DROP SCHEMA IF EXISTS public CASCADE;
CREATE SCHEMA public;
SET search_path TO public;

-- -----------------------------------------------------
-- Tabela: funcionario
-- -----------------------------------------------------
CREATE TABLE funcionario (
    func_cpf VARCHAR(14) PRIMARY KEY,
    func_nome VARCHAR(60) NOT NULL,
    func_senha VARCHAR(20) NOT NULL,
    func_email VARCHAR(30) NOT NULL,
    func_telefone VARCHAR(20) NOT NULL,
    tipo_acesso INT NOT NULL,
    data_admissao DATE NOT NULL,
    data_demissao DATE,
    rua VARCHAR(45) NOT NULL,
    bairro VARCHAR(45) NOT NULL,
    cidade VARCHAR(45) NOT NULL,
    username VARCHAR(20) NOT NULL,
    uf CHAR(2) NOT NULL,
    cep VARCHAR(10) NOT NULL,
    cargo VARCHAR(45) NOT NULL
);

-- -----------------------------------------------------
-- Tabela: categoria_produto
-- -----------------------------------------------------
CREATE TABLE categoria_produto (
    cat_cod SERIAL PRIMARY KEY,
    cat_descr VARCHAR(100) NOT NULL
);

-- -----------------------------------------------------
-- Tabela: produto
-- -----------------------------------------------------
CREATE TABLE produto (
    prod_cod SERIAL PRIMARY KEY,
    prod_descr VARCHAR(100) NOT NULL,
    categoria_produto_cat_cod INT NOT NULL,
    CONSTRAINT fk_produto_categoria FOREIGN KEY (categoria_produto_cat_cod)
        REFERENCES categoria_produto(cat_cod)
        ON DELETE NO ACTION ON UPDATE NO ACTION
);

-- -----------------------------------------------------
-- Tabela: lista_compra
-- -----------------------------------------------------
CREATE TABLE lista_compra (
    lc_cod SERIAL PRIMARY KEY,
    funcionario_func_cpf VARCHAR(14) NOT NULL,
    data_criacao DATE NOT NULL,
    descricao VARCHAR(45) NOT NULL,
    status_atendimento INT NOT NULL
);

ALTER TABLE lista_compra
    ADD CONSTRAINT fk_listacompra_funcionario FOREIGN KEY (funcionario_func_cpf)
        REFERENCES funcionario(func_cpf);

-- -----------------------------------------------------
-- Tabela: estoque
-- -----------------------------------------------------
CREATE TABLE estoque (
    est_cod SERIAL PRIMARY KEY,
    est_prod_quantidade INT NOT NULL,
    data_validade DATE NOT NULL,
    produto_prod_cod INT NOT NULL,
    CONSTRAINT fk_estoque_produto FOREIGN KEY (produto_prod_cod)
        REFERENCES produto(prod_cod)
);

-- -----------------------------------------------------
-- Tabela: cesta_basica
-- -----------------------------------------------------
CREATE TABLE cesta_basica (
    cb_cod SERIAL PRIMARY KEY,
    descricao VARCHAR(100) NOT NULL
);

-- -----------------------------------------------------
-- Tabela: cesta_basica_produto
-- -----------------------------------------------------
CREATE TABLE cesta_basica_produto (
    cesta_basica_cb_cod INT NOT NULL,
    produto_prod_cod INT NOT NULL,
    quantidade INT,
    PRIMARY KEY (cesta_basica_cb_cod, produto_prod_cod),
    CONSTRAINT fk_cesta_produto_cesta FOREIGN KEY (cesta_basica_cb_cod)
        REFERENCES cesta_basica(cb_cod),
    CONSTRAINT fk_cesta_produto_produto FOREIGN KEY (produto_prod_cod)
        REFERENCES produto(prod_cod)
);

-- -----------------------------------------------------
-- Tabela: fornecedor
-- -----------------------------------------------------
CREATE TABLE fornecedor (
    id_fornecedor SERIAL PRIMARY KEY,
    nome VARCHAR(45) NOT NULL,
    email VARCHAR(45) NOT NULL,
    telefone VARCHAR(20) NOT NULL,
    contato VARCHAR(45) NOT NULL,
    descricao VARCHAR(45) NOT NULL
);

-- -----------------------------------------------------
-- Tabela: cotacao
-- -----------------------------------------------------
CREATE TABLE cotacao (
    id_cotacao SERIAL PRIMARY KEY,
    data_abertura DATE NOT NULL,
    data_fechamento DATE NOT NULL
);

-- -----------------------------------------------------
-- Tabela: fornec_cotacao
-- -----------------------------------------------------
CREATE TABLE fornec_cotacao (
    fornecedor_id INT NOT NULL,
    cotacao_id INT NOT NULL,
    status_realizou INT NOT NULL,
    PRIMARY KEY (fornecedor_id, cotacao_id),
    CONSTRAINT fk_fornec_cot_fornecedor FOREIGN KEY (fornecedor_id)
        REFERENCES fornecedor(id_fornecedor),
    CONSTRAINT fk_fornec_cot_cotacao FOREIGN KEY (cotacao_id)
        REFERENCES cotacao(id_cotacao)
);

-- -----------------------------------------------------
-- Tabela: compra
-- -----------------------------------------------------
CREATE TABLE compra (
    compra_cod SERIAL PRIMARY KEY,
    compra_valor_tt double precision NOT NULL,
    data_compra DATE NOT NULL,
    fornec_cotacao_fornecedor_id INT,
    fornec_cotacao_cotacao_id INT,
    fornecedor_id INT,
    funcionario_func_cpf VARCHAR(14),
    CONSTRAINT fk_compra_fornecedor FOREIGN KEY (fornecedor_id)
        REFERENCES fornecedor(id_fornecedor),
    CONSTRAINT fk_compra_funcionario FOREIGN KEY (funcionario_func_cpf)
        REFERENCES funcionario(func_cpf),
    CONSTRAINT fk_compra_fornec_cotacao FOREIGN KEY (fornec_cotacao_fornecedor_id, fornec_cotacao_cotacao_id)
        REFERENCES fornec_cotacao(fornecedor_id, cotacao_id)
);

-- -----------------------------------------------------
-- Tabela: pessoa_carente
-- -----------------------------------------------------
CREATE TABLE pessoa_carente (
    pc_cpf VARCHAR(14) PRIMARY KEY,
    pc_nome VARCHAR(60) NOT NULL,
    pc_data_nasc DATE NOT NULL,
    pc_telefone VARCHAR(20) NOT NULL,
    rua VARCHAR(45) NOT NULL,
    bairro VARCHAR(45) NOT NULL,
    uf CHAR(2) NOT NULL,
    cidade VARCHAR(45) NOT NULL,
    cep VARCHAR(10) NOT NULL
);

-- -----------------------------------------------------
-- Tabela: doacao
-- -----------------------------------------------------
CREATE TABLE doacao (
    doa_cod SERIAL PRIMARY KEY,
    pessoa_carente_pc_cpf VARCHAR(14),
    data_doacao DATE NOT NULL,
    observacao VARCHAR(100),
    CONSTRAINT fk_doacao_pessoa FOREIGN KEY (pessoa_carente_pc_cpf)
        REFERENCES pessoa_carente(pc_cpf)
);

-- -----------------------------------------------------
-- Tabela: doacao_produto (AJUSTADA)
-- -----------------------------------------------------
CREATE TABLE doacao_produto (
    dpp_cod SERIAL PRIMARY KEY,
    doacao_doa_cod INT NOT NULL,
    produto_prod_cod INT NOT NULL,
    doa_prod_qtd INT NOT NULL DEFAULT 0,
    CONSTRAINT fk_doacao_produto_doacao FOREIGN KEY (doacao_doa_cod)
        REFERENCES doacao(doa_cod),
    CONSTRAINT fk_doacao_produto_produto FOREIGN KEY (produto_prod_cod)
        REFERENCES produto(prod_cod)
);

-- -----------------------------------------------------
-- Tabela: itens_compra (AJUSTADA)
-- -----------------------------------------------------
CREATE TABLE itens_compra (
    ic_cod SERIAL PRIMARY KEY,
    produto_prod_cod INT NOT NULL,
    compra_compra_cod INT NOT NULL,
    valor double precision NOT NULL,
    quantidade INT NOT NULL,
    CONSTRAINT fk_itens_compra_produto FOREIGN KEY (produto_prod_cod)
        REFERENCES produto(prod_cod),
    CONSTRAINT fk_itens_compra_compra FOREIGN KEY (compra_compra_cod)
        REFERENCES compra(compra_cod)
);

